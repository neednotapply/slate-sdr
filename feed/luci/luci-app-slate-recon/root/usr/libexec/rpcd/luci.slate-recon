#!/bin/sh
# rpcd plugin for luci-app-slate-recon: the network recon tab talks to the
# slate-recon tool through here.
#
#   ubus call luci.slate-recon uplink                     the joined network
#   ubus call luci.slate-recon discover                   hosts on it (arp-scan)
#   ubus call luci.slate-recon hosts                      the last discover
#   ubus call luci.slate-recon ports '{"target":"1.2.3.4"}'  one host (nmap -F)
#   ubus call luci.slate-recon survey_scan                   one Wi-Fi scan
#   ubus call luci.slate-recon survey_networks               access points seen
#   ubus call luci.slate-recon survey_clear                  forget them
#   ubus call luci.slate-recon survey_gps                    GPS status
#   ubus call luci.slate-recon threats_rogue                 evil-twin check
#   ubus call luci.slate-recon threats_deauth '{"secs":15}'  deauth watch
#
# slate-recon / slate-survey / slate-threats print a JSON object each, the
# ubus reply.

. /usr/share/libubox/jshn.sh

RECON=${SLATE_RECON:-/usr/sbin/slate-recon}
SURVEY=${SLATE_SURVEY:-/usr/sbin/slate-survey}
THREATS=${SLATE_THREATS:-/usr/sbin/slate-threats}
DASH=${SLATE_DASHBOARD:-/usr/sbin/slate-dashboard}

run_ports() {
	local input target
	read -r input
	json_load "$input"
	json_get_var target target
	# slate-recon validates the target; a bad one gets a JSON error back.
	"$RECON" ports "$target"
}

run_deauth() {
	local input secs
	read -r input
	json_load "$input"
	json_get_var secs secs
	# empty -> slate-threats' default window; slate-threats validates it.
	"$THREATS" deauth ${secs:+"$secs"}
}

case "$1" in
list)
	echo '{ "dashboard": {}, "uplink": {}, "discover": {}, "hosts": {}, "ports": { "target": "str" }, "survey_scan": {}, "survey_networks": {}, "survey_clear": {}, "survey_gps": {}, "threats_rogue": {}, "threats_deauth": { "secs": 0 } }'
	;;
call)
	case "$2" in
	dashboard)       "$DASH" ;;
	uplink)          "$RECON" uplink ;;
	discover)        "$RECON" discover ;;
	hosts)           "$RECON" hosts ;;
	ports)           run_ports ;;
	survey_scan)     "$SURVEY" scan ;;
	survey_networks) "$SURVEY" networks ;;
	survey_clear)    "$SURVEY" clear ;;
	survey_gps)      "$SURVEY" gps ;;
	threats_rogue)   "$THREATS" rogue ;;
	threats_deauth)  run_deauth ;;
	esac
	;;
esac
