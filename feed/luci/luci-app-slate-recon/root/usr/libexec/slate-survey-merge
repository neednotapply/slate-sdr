#!/usr/bin/ucode
// slate-survey-merge: the Wi-Fi survey database, keyed by BSSID.
//
//   slate-survey-merge scan       merge NDJSON sightings from stdin, print them
//   slate-survey-merge networks   print every access point seen so far
//   slate-survey-merge clear      forget the logged networks
//
// "scan" reads one JSON object per line (from slate-survey's parser), updates
// networks.json on the card (first/last seen, times seen, strongest signal,
// latest channel/security/SSID, last GPS position) and appends each sighting
// to a wardrive log. It is called by slate-survey, not directly.

'use strict';

import { open, stat, mkdir, stdin } from 'fs';

const STORE = getenv('SLATE_SURVEY_STORE') ?? '/mnt/sdcard/survey';
const DB = STORE + '/networks.json';

function mounted() {
	let f = open('/proc/mounts', 'r');
	if (!f) return false;
	let t = f.read('all') ?? '';
	f.close();
	return index(t, ' /mnt/sdcard ') >= 0;
}

function storeReady() {
	let st = stat(STORE);
	if (st && st.type == 'directory')
		return true;
	if (index(STORE, '/mnt/sdcard') == 0 && !mounted())
		return false;
	mkdir(STORE, 0o755);
	st = stat(STORE);
	return st && st.type == 'directory';
}

function loadDB() {
	let f = open(DB, 'r');
	if (!f) return {};
	let t = f.read('all');
	f.close();
	try { let o = json(t); return (type(o) == 'object') ? o : {}; }
	catch (e) { return {}; }
}

function saveDB(db) {
	if (!storeReady()) return false;
	let f = open(DB, 'w');
	if (!f) return false;
	f.write(sprintf('%J\n', db));
	f.close();
	return true;
}

function appendLog(line) {
	if (!storeReady()) return;
	let name = sprintf('%s/survey-%s.ndjson', STORE, replace(getenv('SLATE_SURVEY_TIME') ?? '', /T.*/, ''));
	let f = open(name, 'a');
	if (!f) return;
	f.write(line + '\n');
	f.close();
}

function byLastSeen(db) {
	let arr = values(db);
	sort(arr, function(a, b) {
		return (a.last < b.last) ? 1 : (a.last > b.last) ? -1 : 0;
	});
	return arr;
}

function doScan() {
	const now = getenv('SLATE_SURVEY_TIME') ?? '';
	const lat = getenv('SLATE_SURVEY_LAT');
	const lon = getenv('SLATE_SURVEY_LON');
	const phy = getenv('SLATE_SURVEY_PHY');
	const gps = (lat != null && lat != '' && lon != null && lon != '');

	let db = loadDB();
	let seen = [];
	let line;

	while ((line = stdin.read('line')) != null) {
		let o;
		try { o = json(line); } catch (e) { continue; }
		if (type(o) != 'object' || !o.bssid)
			continue;

		let k = o.bssid;
		let d = db[k];
		if (!d)
			d = db[k] = { bssid: k, first: now, count: 0, best_signal: -999 };

		d.ssid = o.ssid;
		d.channel = o.channel;
		d.freq = o.freq;
		d.security = o.security;
		d.last = now;
		d.count++;
		if (o.signal > d.best_signal)
			d.best_signal = o.signal;
		if (gps) { d.lat = lat + 0; d.lon = lon + 0; }

		seen = [ ...seen, d ];

		appendLog(sprintf('%J', {
			time: now, bssid: k, ssid: o.ssid, channel: o.channel,
			signal: o.signal, security: o.security,
			lat: gps ? lat + 0 : null, lon: gps ? lon + 0 : null
		}));
	}

	let saved = saveDB(db);

	print(sprintf('%J\n', {
		scanned: now, phy: phy,
		gps: gps ? { lat: lat + 0, lon: lon + 0 } : null,
		saved: saved, total: length(db), found: length(seen),
		networks: seen
	}));
}

function doNetworks() {
	let db = loadDB();
	print(sprintf('%J\n', {
		store: storeReady() ? STORE : null,
		total: length(db),
		networks: byLastSeen(db)
	}));
}

function doClear() {
	let n = length(loadDB());
	if (storeReady()) {
		let f = open(DB, 'w');
		if (f) { f.write('{}\n'); f.close(); }
	}
	print(sprintf('%J\n', { cleared: n }));
}

const cmd = ARGV[0];
if (cmd == 'scan') doScan();
else if (cmd == 'networks') doNetworks();
else if (cmd == 'clear') doClear();
else { warn('usage: slate-survey-merge {scan|networks|clear}\n'); exit(1); }
