#!/bin/sh
# slate-survey: a passive-ish Wi-Fi survey / wardriving logger.
#
#   slate-survey scan [phy]     scan with a free radio, merge into the log
#   slate-survey networks       every access point seen so far, as JSON
#   slate-survey clear          forget the logged networks
#
# A scan is an ordinary Wi-Fi scan (what a phone's network list does) on a
# radio that is not serving the uplink or an access point — by default the
# USB adapter. Each access point found is merged into a database on the
# microSD card under survey/ (first/last seen, times seen, strongest signal,
# channel, security), and every sighting is also appended to a wardrive log
# with a GPS position when a gpsd is running. Nothing is transmitted beyond
# the scan's own probe requests.

MERGE=${SLATE_SURVEY_MERGE:-/usr/libexec/slate-survey-merge}
SCAN_IFACE=slatesurvey

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# A lat,lon from a running gpsd, or empty. gpspipe ships with gpsd.
gps_fix() {
	command -v gpspipe >/dev/null 2>&1 || return 0
	gpspipe -w -n 8 2>/dev/null | sed -n 's/.*"class":"TPV".*"lat":\([-0-9.]*\).*"lon":\([-0-9.]*\).*/\1 \2/p' | head -n 1
}

# The phy to scan on: the USB adapter if present, else a phy with no access
# point and no managed (uplink) interface. Monitor interfaces are fine.
pick_phy() {
	local p drv
	for p in /sys/class/ieee80211/*; do
		[ -e "$p/device/driver" ] || continue
		drv=$(basename "$(readlink "$p/device/driver")")
		[ "$drv" = rt2800usb ] && { basename "$p"; return; }
	done
	for p in /sys/class/ieee80211/*; do
		p=$(basename "$p")
		iw dev | awk -v want="$p" '
			/^phy#/ { cur = "phy" substr($0, 6) }
			/type (AP|managed)/ { if (cur == want) busy = 1 }
			END { exit busy }' && { echo "$p"; return; }
	done
}

# iw scan output -> one JSON object per access point (NDJSON).
parse_scan() {
	awk '
		function flush() {
			if (bssid == "") return
			ch = chan; if (ch == "") ch = freq2chan(freq)
			sec = "Open"
			if (privacy) sec = "WEP"
			if (wpa) sec = "WPA"
			if (rsn) sec = "WPA2"
			if (rsn && ent) sec = "WPA2-Ent"
			if (sae) sec = "WPA3"
			printf "{\"bssid\":\"%s\",\"ssid\":\"%s\",\"freq\":%d,\"channel\":%d,\"signal\":%d,\"security\":\"%s\"}\n", \
				bssid, esc(ssid), freq+0, ch+0, sig+0, sec
		}
		function esc(s) { gsub(/\\/, "\\\\", s); gsub(/"/, "\\\"", s); return s }
		function freq2chan(f) {
			if (f >= 2412 && f <= 2472) return (f - 2407) / 5
			if (f == 2484) return 14
			if (f >= 5000 && f <= 5900) return (f - 5000) / 5
			return 0
		}
		/^BSS / { flush(); bssid=substr($2,1,17); ssid=""; freq=0; sig=0; chan=""; privacy=0; wpa=0; rsn=0; sae=0; ent=0 }
		/^[ \t]*freq:/ { freq=$2 }
		/^[ \t]*signal:/ { sig=$2 }
		/SSID:/ { s=$0; sub(/^[ \t]*SSID: ?/, "", s); ssid=s }
		/primary channel:/ { chan=$NF }
		/DS Parameter set: channel/ { if (chan=="") chan=$NF }
		/capability:.*Privacy/ { privacy=1 }
		/^[ \t]*RSN:/ { rsn=1 }
		/^[ \t]*WPA:/ { wpa=1 }
		/Authentication suites:.*SAE/ { sae=1 }
		/Authentication suites:.*(802.1X|8021X)/ { ent=1 }
		END { flush() }
	'
}

cmd_scan() {
	local phy="${1:-$(pick_phy)}" gps lat lon
	[ -n "$phy" ] || { echo '{ "error": "no free radio to scan with (all are serving the uplink or an access point)" }'; return; }

	iw phy "$phy" interface add "$SCAN_IFACE" type managed >/dev/null 2>&1 || {
		echo "{ \"error\": \"could not add a scan interface on $phy\" }"; return; }
	ip link set "$SCAN_IFACE" up 2>/dev/null
	sleep 1

	gps=$(gps_fix)
	lat=${gps% *}; lon=${gps#* }
	[ "$gps" = "$lat" ] && { lat=; lon=; }

	iw dev "$SCAN_IFACE" scan 2>/dev/null | parse_scan |
		SLATE_SURVEY_TIME="$(now)" SLATE_SURVEY_LAT="$lat" SLATE_SURVEY_LON="$lon" \
		SLATE_SURVEY_PHY="$phy" "$MERGE" scan

	ip link set "$SCAN_IFACE" down 2>/dev/null
	iw dev "$SCAN_IFACE" del 2>/dev/null
}

case "$1" in
scan)     shift; cmd_scan "$@" ;;
networks) "$MERGE" networks ;;
clear)    "$MERGE" clear ;;
*) echo "usage: slate-survey {scan [phy]|networks|clear}" >&2; exit 1 ;;
esac
