# slate-sdr: receivers on the GL-AR750S.
#
# Each radio runs one job at a time; of two enabled jobs on the same radio,
# the first one listed wins. After editing: /etc/init.d/slate-sdr restart
# Every job also takes option extra_args '...', appended to its command.

config storage 'storage'
	# The microSD card: format it exFAT and name (label) it SLATESDR.
	option mountpoint '/mnt/sdcard'
	option dir 'slate-sdr'
	option min_free_mb '256'
	# Do not write to the router's own flash when no card is in.
	option require_mount '1'

# Both radios on the network for SoapySDR clients (SDR++, GQRX, CubicSDR,
# SDRangel, GNU Radio): driver=remote,remote=tcp://<router>:55132
# Holds no radio until a client opens one.
config job 'soapy'
	option type 'soapy_server'
	option enabled '1'
	#option bind '0.0.0.0:55132'

# Aircraft (ADS-B, 1090 MHz) on the RTL-SDR: live map on
# http://<router>:8080/, SBS on port 30003, Beast on 30005, and the aircraft
# table appended to the card every log_every seconds.
config job 'adsb'
	option type 'adsb'
	option enabled '1'
	option log_every '60'
	#option gain '49.6'
	#option lat '51.5'
	#option lon '-0.1'

# Spectrum survey with the HackRF: 1 MHz to 6 GHz, one sweep a minute, CSV
# to the card. Between sweeps the HackRF is free for network clients.
config job 'survey'
	option type 'sweep'
	option radio 'hackrf'
	option enabled '1'
	# hackrf_sweep -f: MHz
	option range '1:6000'
	option bin_width '1000000'
	option interval '60'
	option rotate 'hour'
	option lna '16'
	option vga '20'
	option amp '0'

# The RTL-SDR as an rtl_tcp server (SDR#, SDR++, GQRX): <router>:1234
config job 'rtltcp'
	option type 'rtl_tcp'
	option enabled '0'
	option port '1234'
	#option gain '40'

# Sensors, remotes and meters (433/868/915 MHz) with rtl_433: JSON lines to
# the card, live view on http://<router>:8433/
config job 'ism'
	option type 'ism'
	option enabled '0'
	list frequency '433.92M'
	#list frequency '868M'
	#list frequency '915M'
	option hop_interval '600'
	option http_port '8433'

# Ships (AIS, 162 MHz) with rtl_ais: NMEA on TCP <router>:10110 (OpenCPN),
# sentences logged to the card.
config job 'ais'
	option type 'ais'
	option enabled '0'
	option port '10110'

# Spectrum survey with the RTL-SDR: 24 MHz to 1.766 GHz.
config job 'rtlsurvey'
	option type 'sweep'
	option radio 'rtlsdr'
	option enabled '0'
	# rtl_power -f: low:high:bin
	option range '24M:1766M:250k'
	option integration '10'
	option interval '60'
	#option gain '30'

# Raw IQ to the card as SigMF recordings (open with inspectrum, URH,
# SigDigger, GNU Radio), in segment-second files. 2 Msps is 4 MB/s.
config job 'iq'
	option type 'iq'
	option radio 'hackrf'
	option enabled '0'
	option frequency '433.92M'
	option rate '2M'
	option segment '600'
	option lna '16'
	option vga '20'
	option amp '0'

# Spectral scan of the router's own Wi-Fi radios (2.4 and 5 GHz), raw FFT
# samples to the card. Needs the full build, and radios not used as an AP.
config job 'wifi'
	option type 'wifi_spectral'
	option enabled '0'
	option interval '60'
	option bands '2g 5g'
	#option country 'US'
