#!/bin/sh
# First boot: mount the microSD card labelled SLATESDR at /mnt/sdcard, and
# serve its contents (directory listings) on port 8081.

[ -f /etc/config/fstab ] || touch /etc/config/fstab
uci -q get fstab.slatesdr > /dev/null || uci -q batch <<-EOT
	set fstab.slatesdr=mount
	set fstab.slatesdr.target='/mnt/sdcard'
	set fstab.slatesdr.label='SLATESDR'
	set fstab.slatesdr.options='rw,noatime'
	set fstab.slatesdr.enabled='1'
	commit fstab
EOT

uci -q get uhttpd.slatesdr > /dev/null || uci -q batch <<-EOT
	set uhttpd.slatesdr=uhttpd
	add_list uhttpd.slatesdr.listen_http='0.0.0.0:8081'
	add_list uhttpd.slatesdr.listen_http='[::]:8081'
	set uhttpd.slatesdr.home='/mnt/sdcard'
	set uhttpd.slatesdr.rfc1918_filter='1'
	set uhttpd.slatesdr.max_requests='3'
	set uhttpd.slatesdr.max_connections='20'
	set uhttpd.slatesdr.network_timeout='30'
	set uhttpd.slatesdr.http_keepalive='20'
	commit uhttpd
EOT

exit 0
