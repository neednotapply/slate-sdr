#!/bin/sh /etc/rc.common
# slate-sdr: one procd instance per enabled job in /etc/config/slate-sdr.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/libexec/slate-sdr-job

start_job() {
	local cfg="$1" enabled type radio dev claim
	config_get_bool enabled "$cfg" enabled 0
	[ "$enabled" = 1 ] || return 0
	config_get type "$cfg" type

	radio=$(slate_job_radio "$cfg" "$type")
	if [ -n "$radio" ]; then
		config_get dev "$cfg" device 0
		claim="$radio:$dev"
		case " $CLAIMED " in
		*" $claim "*)
			logger -t slate-sdr "job '$cfg' not started: its $radio is taken by another enabled job"
			return 0
			;;
		esac
		CLAIMED="$CLAIMED $claim"
	fi

	if [ "$type" = wifi_spectral ] && [ -z "$(slate_spectral_dirs)" ]; then
		logger -t slate-sdr "job '$cfg' not started: this firmware has no Wi-Fi spectral scan (use the full build)"
		return 0
	fi

	procd_open_instance "$cfg"
	procd_set_param command "$PROG" "$cfg"
	procd_set_param respawn 3600 10 0
	procd_set_param term_timeout 15
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

start_service() {
	. /usr/share/slate-sdr/lib.sh
	CLAIMED=
	config_load slate-sdr
	config_foreach start_job job
}

service_triggers() {
	procd_add_reload_trigger slate-sdr
}
