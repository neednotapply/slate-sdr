#!/bin/sh
# Make sure uhttpd exposes the ubus JSON-RPC endpoint (/ubus) the Slate web UI
# calls, then reload uhttpd. Idempotent, and safe alongside LuCI, which wants
# the same endpoint.
if uci -q get uhttpd.main >/dev/null 2>&1; then
	if [ "$(uci -q get uhttpd.main.ubus_prefix)" != "/ubus" ]; then
		uci set uhttpd.main.ubus_prefix='/ubus'
		uci commit uhttpd
	fi
fi
/etc/init.d/uhttpd reload >/dev/null 2>&1
exit 0
