#!/bin/sh
# slate-upload: CGI endpoint that stages a firmware image for the Slate UI.
# The browser PUTs (or POSTs) the raw image bytes; this writes them to $IMG and
# returns JSON. It only STAGES the file — it never flashes. Applying is a
# separate, authenticated ubus call (luci.slate-firmware apply) that re-verifies
# the image first, so staging a file here cannot by itself change the firmware.
#
# Served by uhttpd at /cgi-bin/slate-upload.

IMG=${SLATE_FIRMWARE_IMG:-/tmp/slate-firmware.img}
MAX=${SLATE_UPLOAD_MAX:-41943040}   # 40 MB; a sysupgrade image is well under this

printf 'Content-Type: application/json\r\n\r\n'

len=${CONTENT_LENGTH:-0}
case "$len" in ''|*[!0-9]*) len=0 ;; esac
if [ "$len" -le 0 ]; then echo '{ "ok": false, "error": "no data" }'; exit 0; fi
if [ "$len" -gt "$MAX" ]; then echo '{ "ok": false, "error": "image too large" }'; exit 0; fi

rm -f "$IMG" "$IMG.ok"
head -c "$len" > "$IMG"
got=$(wc -c < "$IMG" 2>/dev/null)
if [ "$got" = "$len" ]; then
	printf '{ "ok": true, "size": %s }\n' "$got"
else
	rm -f "$IMG"
	echo '{ "ok": false, "error": "upload truncated" }'
fi
