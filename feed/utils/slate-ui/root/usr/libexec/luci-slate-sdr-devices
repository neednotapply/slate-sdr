#!/usr/bin/ucode
// Devices rtl_433 has decoded, for the LuCI ISM sensors tab: reads the ISM
// job's newest two daily JSON logs on the card (at most MAX_BYTES of each,
// from the end) and prints one JSON object with the latest readings per
// device. Called by the luci.slate-sdr rpcd plugin.

'use strict';

import { lsdir, stat, open } from 'fs';
import { cursor } from 'uci';

const MAX_BYTES = 2 * 1024 * 1024;

// rtl_433 fields that describe the message rather than the reading.
const META = {
	time: true, model: true, id: true, channel: true, subtype: true,
	protocol: true, mod: true, freq: true, freq1: true, freq2: true,
	rssi: true, snr: true, noise: true, mic: true
};

const uci = cursor();

// SLATE_ISM_DIR points it at another folder of day directories (tests).
const base = getenv('SLATE_ISM_DIR') ?? sprintf('%s/%s/ism',
	uci.get('slate-sdr', 'storage', 'mountpoint') ?? '/mnt/sdcard',
	uci.get('slate-sdr', 'storage', 'dir') ?? 'slate-sdr');

function logFiles() {
	let files = [];

	for (let day in sort(lsdir(base) ?? []))
		for (let name in sort(lsdir(`${base}/${day}`) ?? []))
			if (match(name, /^ism-[0-9]+\.json$/))
				push(files, `${base}/${day}/${name}`);

	return slice(files, -2);
}

function tailLines(path) {
	const st = stat(path), fd = open(path, 'r');
	let skipFirst = false;

	if (!st || !fd)
		return [];

	if (st.size > MAX_BYTES) {
		fd.seek(st.size - MAX_BYTES);
		skipFirst = true;
	}

	let lines = split(fd.read('all') ?? '', '\n');
	fd.close();

	if (skipFirst)
		shift(lines);

	return lines;
}

const files = logFiles();
const devices = {};
let decoded = 0;

for (let path in files) {
	for (let line in tailLines(path)) {
		let ev;

		if (substr(line, 0, 1) != '{')
			continue;

		try { ev = json(line); } catch (e) { continue; }

		if (type(ev) != 'object' || !ev.model)
			continue;

		decoded++;

		const key = join('|', [ ev.model, ev.id ?? '', ev.channel ?? '', ev.subtype ?? '' ]);
		let d = devices[key];

		if (!d)
			d = devices[key] = {
				model: ev.model, id: ev.id, channel: ev.channel,
				first: ev.time, count: 0, readings: {}
			};

		d.count++;
		d.last = ev.time;
		d.freq = ev.freq ?? d.freq;
		d.snr = ev.snr ?? d.snr;

		for (let k, v in ev)
			if (!META[k])
				d.readings[k] = v;
	}
}

let freqs = uci.get('slate-sdr', 'ism', 'frequency') ?? [ '433.92M' ];

print(sprintf('%J\n', {
	now: time(),
	enabled: uci.get('slate-sdr', 'ism', 'enabled') == '1',
	frequencies: type(freqs) == 'array' ? freqs : [ freqs ],
	hop_interval: +(uci.get('slate-sdr', 'ism', 'hop_interval') ?? 600),
	files: files,
	decoded: decoded,
	devices: values(devices)
}));
