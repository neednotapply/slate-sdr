#!/bin/sh
# rpcd plugin for the Slate web UI's capture workbench. A thin wrapper over the
# slate-capture tool.
#
#   ubus call luci.slate-capture interfaces
#   ubus call luci.slate-capture status
#   ubus call luci.slate-capture list
#   ubus call luci.slate-capture start '{"iface":"br-lan","filter":"","name":""}'
#   ubus call luci.slate-capture stop

. /usr/share/libubox/jshn.sh

CAP=${SLATE_CAPTURE:-/usr/sbin/slate-capture}

run_start() {
	local input iface filter name
	read -r input
	json_load "$input"
	json_get_var iface iface
	json_get_var filter filter
	json_get_var name name
	"$CAP" start "$iface" "$filter" "$name"
}

case "$1" in
list)
	echo '{ "interfaces": {}, "status": {}, "list": {}, "start": { "iface": "str", "filter": "str", "name": "str" }, "stop": {} }'
	;;
call)
	case "$2" in
	interfaces) "$CAP" interfaces ;;
	status)     "$CAP" status ;;
	list)       "$CAP" list ;;
	start)      run_start ;;
	stop)       "$CAP" stop ;;
	esac
	;;
esac
