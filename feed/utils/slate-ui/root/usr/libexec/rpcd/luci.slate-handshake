#!/bin/sh
# rpcd plugin for the Slate web UI's passive handshake capture. A thin wrapper
# over the slate-handshake tool.
#
#   ubus call luci.slate-handshake radios
#   ubus call luci.slate-handshake status
#   ubus call luci.slate-handshake list
#   ubus call luci.slate-handshake start '{"phy":"phy1","channel":"6","name":""}'
#   ubus call luci.slate-handshake stop

. /usr/share/libubox/jshn.sh

HS=${SLATE_HANDSHAKE:-/usr/sbin/slate-handshake}

run_start() {
	local input phy channel name
	read -r input
	json_load "$input"
	json_get_var phy phy
	json_get_var channel channel
	json_get_var name name
	"$HS" start "$phy" "$channel" "$name"
}

case "$1" in
list)
	echo '{ "radios": {}, "status": {}, "list": {}, "start": { "phy": "str", "channel": "str", "name": "str" }, "stop": {} }'
	;;
call)
	case "$2" in
	radios) "$HS" radios ;;
	status) "$HS" status ;;
	list)   "$HS" list ;;
	start)  run_start ;;
	stop)   "$HS" stop ;;
	esac
	;;
esac
