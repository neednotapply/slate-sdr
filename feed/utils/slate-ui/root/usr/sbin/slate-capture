#!/bin/sh
# slate-capture: passive packet capture to the microSD card for the Slate web
# UI. tcpdump writes a pcap; one capture runs at a time, size-rotated so it
# cannot fill the card. Read-only except start/stop. Prints one JSON object per
# subcommand (the reply the luci.slate-capture rpcd plugin returns).
#
#   slate-capture interfaces
#   slate-capture start <iface> [bpf filter] [name]
#   slate-capture stop
#   slate-capture status
#   slate-capture list
#
# This captures on ordinary interfaces (the LAN/AP bridge, the uplink); it does
# not put a radio into monitor mode and does not transmit.

. /usr/share/libubox/jshn.sh

STATE=/tmp/slate-capture.state

card_dir() {
	local mp dir
	mp=$(uci -q get slate-sdr.storage.mountpoint); [ -n "$mp" ] || mp=/mnt/sdcard
	dir=$(uci -q get slate-sdr.storage.dir); [ -n "$dir" ] || dir=slate-sdr
	printf '%s/%s/capture' "$mp" "$dir"
}

alive() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }

read_state() {
	PID=; IFACE=; FILTER=; FILE=; START=
	# shellcheck disable=SC1090
	[ -f "$STATE" ] && . "$STATE"
}

cmd_interfaces() {
	local path n st
	json_init
	json_add_array interfaces
	for path in /sys/class/net/*; do
		n=$(basename "$path")
		[ "$n" = lo ] && continue
		st=$(cat "$path/operstate" 2>/dev/null)
		json_add_object ""
		json_add_string name "$n"
		json_add_string state "${st:-unknown}"
		json_close_object
	done
	json_close_array
	json_dump
}

cmd_status() {
	local running=0 size=0 elapsed=0 base

	read_state
	if alive "$PID"; then
		running=1
		[ -f "$FILE" ] && size=$(wc -c < "$FILE" 2>/dev/null)
		[ -n "$START" ] && elapsed=$(( $(date +%s) - START ))
	fi
	base=
	[ -n "$FILE" ] && base=$(basename "$FILE")

	json_init
	json_add_boolean running "$running"
	json_add_string iface "${IFACE:-}"
	json_add_string filter "${FILTER:-}"
	json_add_string file "$base"
	json_add_int size "${size:-0}"
	json_add_int elapsed "${elapsed:-0}"
	json_dump
}

cmd_start() {
	local iface="$1" filter="$2" name="$3" dir file ts

	read_state
	alive "$PID" && { echo '{ "error": "a capture is already running" }'; return; }

	[ -d "/sys/class/net/$iface" ] || { echo '{ "error": "no such interface" }'; return; }
	# Conservative whitelist for the optional BPF filter (no shell metacharacters).
	if [ -n "$filter" ] && printf '%s' "$filter" | grep -q '[^A-Za-z0-9 ._:/()-]'; then
		echo '{ "error": "filter has disallowed characters" }'; return
	fi
	case "$name" in
	*[!A-Za-z0-9._-]*) name= ;;
	esac

	dir=$(card_dir)
	mkdir -p "$dir" 2>/dev/null || { echo '{ "error": "microSD card not mounted (no capture directory)" }'; return; }

	ts=$(date +%Y%m%d-%H%M%S)
	file="$dir/${name:+$name-}cap-$ts.pcap"

	# Detached, size-rotated at ~5 MB, up to ~20 files (~100 MB cap). The BPF
	# filter is passed as one validated argument so parentheses are safe.
	if [ -n "$filter" ]; then
		setsid tcpdump -i "$iface" -U -s 0 -C 5 -W 20 -w "$file" "$filter" >/dev/null 2>&1 &
	else
		setsid tcpdump -i "$iface" -U -s 0 -C 5 -W 20 -w "$file" >/dev/null 2>&1 &
	fi
	PID=$!

	{
		echo "PID=$PID"
		echo "IFACE='$iface'"
		echo "FILTER='$filter'"
		echo "FILE='$file'"
		echo "START=$(date +%s)"
	} > "$STATE"

	sleep 1
	alive "$PID" || { rm -f "$STATE"; echo '{ "error": "capture failed to start (check the interface and filter)" }'; return; }
	logger -t slate-capture "capture started on $iface${filter:+ ($filter)} -> $file"
	cmd_status
}

cmd_stop() {
	read_state
	alive "$PID" && kill "$PID" 2>/dev/null
	rm -f "$STATE"
	echo '{ "stopped": true }'
}

cmd_list() {
	local dir f sz mt
	dir=$(card_dir)
	json_init
	json_add_array files
	if [ -d "$dir" ]; then
		for f in "$dir"/*.pcap*; do
			[ -f "$f" ] || continue
			sz=$(wc -c < "$f" 2>/dev/null)
			mt=$(date -r "$f" '+%Y-%m-%d %H:%M' 2>/dev/null)
			json_add_object ""
			json_add_string name "$(basename "$f")"
			json_add_int size "${sz:-0}"
			json_add_string mtime "${mt:-}"
			json_close_object
		done
	fi
	json_close_array
	json_dump
}

case "$1" in
interfaces) cmd_interfaces ;;
start)      cmd_start "$2" "$3" "$4" ;;
stop)       cmd_stop ;;
status)     cmd_status ;;
list)       cmd_list ;;
*) echo '{ "error": "usage: slate-capture interfaces|start <iface> [filter] [name]|stop|status|list" }' ;;
esac
