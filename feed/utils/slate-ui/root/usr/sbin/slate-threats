#!/bin/sh
# slate-threats: passive Wi-Fi threat detection for the travelling Slate.
#
#   slate-threats rogue            evil-twin / rogue-AP check over the survey
#   slate-threats deauth [secs]    listen for deauth/disassoc floods (default 15s)
#
# "rogue" reads the access points the Wi-Fi survey has logged and flags an
# SSID advertised both open and secured, or one of your own networks being
# impersonated. "deauth" watches the monitor interface for the management
# frames a deauthentication attack sends. Both only listen — nothing is
# transmitted, and nothing here attacks a network.

MERGE=${SLATE_SURVEY_MERGE:-/usr/libexec/slate-survey-merge}
MON=${SLATE_MON_IFACE:-mon0}

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Your own SSIDs: the uplink you joined and any access point this router runs.
own_ssids() {
	local iface s
	iface=$(ip route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
	[ -n "$iface" ] && iwinfo "$iface" info 2>/dev/null | sed -n 's/.*ESSID: "\(.*\)"/\1/p'
	for s in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)\.mode='ap'/\1/p"); do
		[ "$(uci -q get "wireless.$s.disabled")" = 1 ] && continue
		uci -q get "wireless.$s.ssid"
	done
}

cmd_rogue() {
	own_ssids | sort -u | SLATE_SURVEY_TIME="$(now)" "$MERGE" threats
}

# Turn tcpdump -e lines (deauth/disassoc frames) on stdin into the report
# JSON. Split out from the capture so it can be tested with sample frames.
# Args: window seconds, channel, interface.
deauth_report() {
	local secs="$1" ch="$2" iface="$3" lines total deauth disassoc sources alert
	lines=$(cat)

	total=$(printf '%s' "$lines" | grep -c . )
	deauth=$(printf '%s' "$lines" | grep -c -i deauth )
	disassoc=$(printf '%s' "$lines" | grep -c -i disassoc )
	sources=$(printf '%s\n' "$lines" | grep -oE 'SA:[0-9a-f:]{17}' | sed 's/SA://' |
		sort | uniq -c | sort -rn | head -n 10 |
		awk '{ printf "%s{ \"mac\": \"%s\", \"count\": %d }", (NR>1?", ":""), $2, $1 }')

	[ "$total" -ge 10 ] && alert=true || alert=false

	printf '{ "window_s": %d, "iface": "%s", "channel": %s, "total": %d, "deauth": %d, "disassoc": %d, "alert": %s, "sources": [ %s ] }\n' \
		"$secs" "$iface" "${ch:-0}" "$total" "$deauth" "$disassoc" "$alert" "$sources"
}

cmd_deauth() {
	local secs="${1:-15}" ch pcap tp

	case "$secs" in
	''|*[!0-9]*) echo '{ "error": "seconds must be a whole number" }'; return ;;
	esac
	[ "$secs" -ge 1 ] && [ "$secs" -le 120 ] || { echo '{ "error": "seconds must be 1 to 120" }'; return; }

	ip link set "$MON" up 2>/dev/null || { echo "{ \"error\": \"no monitor interface $MON\" }"; return; }
	ch=$(iw dev "$MON" info 2>/dev/null | sed -n 's/.*channel \([0-9]*\).*/\1/p')

	pcap="/tmp/slate-deauth.$$.pcap"
	tcpdump -i "$MON" -n -e -s 128 -w "$pcap" \
		'wlan type mgt subtype deauth or wlan type mgt subtype disassoc' >/dev/null 2>&1 &
	tp=$!
	sleep "$secs"
	kill "$tp" 2>/dev/null
	wait "$tp" 2>/dev/null

	tcpdump -r "$pcap" -n -e 2>/dev/null | deauth_report "$secs" "${ch:-0}" "$MON"
	rm -f "$pcap"
}

case "$1" in
rogue)         cmd_rogue ;;
deauth)        shift; cmd_deauth "$@" ;;
deauth-report) deauth_report "${2:-0}" "${3:-0}" "${4:-mon0}" ;;  # stdin: tcpdump -e lines (tests)
*) echo "usage: slate-threats {rogue|deauth [secs]}" >&2; exit 1 ;;
esac
